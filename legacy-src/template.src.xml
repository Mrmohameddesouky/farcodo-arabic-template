<head>
<meta charset='utf-8'/>
<meta content='width=device-width,initial-scale=1' name='viewport'/>
<meta content='#0a5cff' name='theme-color'/>
<!-- Farcodo Arabic Blogger template — original work. See LICENSES.md for third-party notes. -->
<b:include data='blog' name='all-head-content'/>
<title><b:if cond='data:blog.pageType == "index" and data:blog.url == data:blog.homepageUrl'><data:blog.title/><b:elseif cond='data:blog.pageType == "error_page"'/>الصفحة غير موجودة - <data:blog.title/><b:elseif cond='data:blog.searchLabel'/>قسم <data:blog.searchLabel/> - <data:blog.title/><b:elseif cond='data:blog.searchQuery'/>نتائج البحث عن <data:blog.searchQuery/> - <data:blog.title/><b:elseif cond='data:blog.pageType == "archive"'/>أرشيف <data:blog.pageName/> - <data:blog.title/><b:elseif cond='data:blog.pageType == "index"'/>أحدث المقالات - <data:blog.title/><b:else/><data:blog.pageName/> - <data:blog.title/></b:if></title>
<b:if cond='data:blog.pageType == "error_page"'><meta content='noindex,nofollow' name='robots'/><b:elseif cond='data:blog.pageType == "item" or data:blog.pageType == "static_page" or data:blog.url == data:blog.homepageUrl'/><meta content='index,follow,max-image-preview:large' name='robots'/></b:if>
<meta content='summary_large_image' name='twitter:card'/>
<link href='@@FAV64@@' rel='icon' type='image/png'/>
<link href='@@APPLE180@@' rel='apple-touch-icon'/>
<link href='https://fonts.googleapis.com' rel='preconnect'/>
<link crossorigin='anonymous' href='https://fonts.gstatic.com' rel='preconnect'/>
<link href='https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&amp;display=swap' rel='stylesheet'/>
<script>//<![CDATA[
(function(){try{var t=localStorage.getItem('fc-theme');if(t!=='dark'&&t!=='light'){t=(window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light'}document.documentElement.setAttribute('data-theme',t)}catch(e){document.documentElement.setAttribute('data-theme','light')}})();
//]]></script>
<b:skin><![CDATA[
